# Copy this file to an instance-specific name, for example:
#   cp devspace.env.example devspace-22.env
#
# Then edit the copied file. Do not commit the real .env file.

DEVSPACE_CONTROL_PLANE=https://www.astmars.com
DEVSPACE_TUNNEL_TOKEN=<tunnel-token>
TUNNEL_ID=tunnel_<32-lowercase-hex>

# Local Streamable HTTP MCP server.
MCP_URL=http://127.0.0.1:3010/

# Enterprise proxy used by the real browser.
HTTPS_PROXY=http://<enterprise-proxy-host>:8080

# chrome or msedge
DEVSPACE_BROWSER=chrome

# How long start/probe waits for you to complete browser SSO/approval.
DEVSPACE_SSO_WAIT_SECONDS=180

# Optional: use a fixed persistent browser profile path.
# DEVSPACE_BROWSER_PROFILE=C:/Users/<user>/.devspace-browser-tunnel/devspace-22

# Optional: if the enterprise approval button has a stable CSS selector,
# the client can click it automatically.
# DEVSPACE_SSO_APPROVE_SELECTOR=#approve-button
